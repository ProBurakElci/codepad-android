<?xml version="1.0" encoding="utf-8"?>
<!--
  One WebView, filling the window. The editor inside it does its own layout.
  fitsSystemWindows keeps the page clear of the status bar; the page itself
  also uses env(safe-area-inset-top), which covers displays with a cutout.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/window">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
