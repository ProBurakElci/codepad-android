<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The editor is dark, so the app is dark: a light system theme would show
      a white flash before the page paints, and a white status bar above it.
    -->
    <style name="Theme.Codepad" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
        <item name="android:windowBackground">@color/window</item>
        <item name="colorAccent">@color/accent</item>
    </style>
</resources>
