<?xml version="1.0" encoding="utf-8"?>
<!--
  No <uses-permission> anywhere in this file, and that is deliberate.

  Files are opened through the system document picker, which hands back one
  file the user chose and nothing else on the device - so the app needs no
  storage permission. It needs no INTERNET permission either: the editor is
  in assets/ and runs offline.

  One consequence worth knowing: Python is Pyodide, downloaded on first use,
  and without INTERNET that download cannot happen. Python is therefore not
  offered in this build. JavaScript and HTML run, and the app says so.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Codepad">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Tapping a code file in a file manager opens it here. Android
              matches on the MIME type the provider reports, and most code
              files come through as text/plain or octet-stream, which is why
              the extension list below exists as well.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/x-sh" />
                <data android:mimeType="application/xml" />
            </intent-filter>

            <!-- Share a snippet from another app into the editor. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

    <!--
      So the Source code link can find a browser on Android 11 and later,
      where an app cannot otherwise see what else is installed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
